---
import AmazonLink from "./AmazonLink.astro";
import { amazonBookUrl, amazonSearchUrl } from "../lib/site";

interface Props {
  title: string;
  /** Optional author when the StartHere door title alone is ambiguous. */
  author?: string;
  /**
   * Optional shop control inside this callout.
   * Off by default: guide heroes and question answers render one BookOneCard
   * instead of a second start-here button in this block.
   */
  shop?: boolean;
}

const { title, author, shop = false } = Astro.props;
const multiDoor = /(?:—|–|\bor\b)/i.test(title);
const shopHref = !shop || multiDoor
  ? undefined
  : author
    ? amazonBookUrl(title, author)
    : amazonSearchUrl(title);
const showShop = Boolean(shopHref);
---

<div class="start-here">
  <p class="start-here-kicker">Short answer · Start here</p>
  <p class="start-here-title">{title}</p>
  <div class="start-here-body">
    <slot />
  </div>
  {
    showShop && shopHref && (
      <p class="start-here-shop">
        <AmazonLink class="amazon-link start-here-amazon" href={shopHref}>
          Book 1 on Amazon
          <span class="visually-hidden">{` · ${title}`}</span>
        </AmazonLink>
      </p>
    )
  }
</div>
