---
import { lookupAsin, lookupAsinByTitle } from "../lib/asins";
import { amazonBookUrl, amazonRel } from "../lib/site";

interface Props {
  title: string;
  /** Optional author when the StartHere door title alone is ambiguous. */
  author?: string;
}

const { title, author } = Astro.props;
const multiDoor = /(?:—|–|\bor\b)/i.test(title);
const resolvedAsin = multiDoor
  ? undefined
  : author
    ? lookupAsin(title, author)
    : lookupAsinByTitle(title);
const shopHref = resolvedAsin
  ? amazonBookUrl(title, author ?? "", { asin: resolvedAsin })
  : undefined;
const showShop = Boolean(shopHref && resolvedAsin);
---

<div class="start-here">
  <p class="start-here-kicker">Short answer · Start here</p>
  <p class="start-here-title">{title}</p>
  <div class="start-here-body">
    <slot />
  </div>
  {
    showShop && shopHref && (
      <p class="start-here-shop">
        <a class="amazon-link start-here-amazon" href={shopHref} rel={amazonRel}>
          Book 1 on Amazon
          <span class="visually-hidden">{` · ${title}`}</span>
        </a>
      </p>
    )
  }
</div>
