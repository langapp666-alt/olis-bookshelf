---
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-brand">Oli's Bookshelf</p>
      <p class="small footer-blurb">
        Reading-order maps for long science fiction, fantasy, mystery, and romance
        series. Publication first. Chronology when it matters.
      </p>
    </div>
    <div class="footer-cols">
      <p class="footer-links">
        <a href="/guides/">Guides</a>
        <a href="/genres/epic-fantasy/">Fantasy</a>
        <a href="/genres/space-opera/">Space</a>
        <a href="/genres/mystery-thriller/">Mystery</a>
        <a href="/genres/romance/">Romance</a>
      </p>
      <p class="footer-links">
        <a href="/about/">About</a>
        <a href="/questions/">Questions</a>
        <a href="/methodology/">Methodology</a>
        <a href="/disclosure/">Disclosure</a>
      </p>
      <SocialLinks variant="footer" />
      <p class="footer-disclosure">
        As an Amazon Associate I earn from qualifying purchases.{" "}
        <a href="/disclosure/">Disclosure</a>
      </p>
      <p class="footer-copy">© {year} Oli's Bookshelf</p>
    </div>
  </div>
</footer>
