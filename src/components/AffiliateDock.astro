---
import { amazonRel } from "../lib/site";
import type { RecommendedBook } from "../lib/guide-shop";

interface Props {
  book: RecommendedBook;
  /** Visible label prefix; default “Book 1 on Amazon”. */
  label?: string;
}

const { book, label = "Book 1 on Amazon" } = Astro.props;
---

<div class="guide-dock">
  <div class="guide-dock-inner">
    <a class="amazon-link dock-amazon" href={book.href} rel={amazonRel}>
      {label}
      <span class="dock-amazon-label"> · {book.title}</span>
    </a>
  </div>
</div>
