---
import { amazonRel, amazonSearchUrl } from "../lib/site";

interface Props {
  query: string;
  label?: string;
}

const { query, label = query } = Astro.props;
const href = amazonSearchUrl(query);
---

<div class="guide-dock">
  <div class="guide-dock-inner">
    <a class="amazon-link dock-amazon" href={href} rel={amazonRel}>
      Amazon
      <span class="dock-amazon-label"> · {label}</span>
    </a>
  </div>
</div>
