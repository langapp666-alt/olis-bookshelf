---
import type { CollectionEntry } from "astro:content";

interface Props {
  guides: CollectionEntry<"guides">[];
}

const { guides } = Astro.props;
---

{
  guides.length > 0 && (
    <section class="related-guides" aria-labelledby="related-guides-heading">
      <p class="eyebrow">Same shelf</p>
      <h2 id="related-guides-heading">Related guides</h2>
      <ul class="related-guides-list">
        {guides.map((guide) => (
          <li>
            <a href={`/guides/${guide.data.slug}/`}>{guide.data.series}</a>
            <span class="related-guides-author">{guide.data.author}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}
