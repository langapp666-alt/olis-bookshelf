---
interface Props {
  flags?: string[];
}

const { flags = [] } = Astro.props;
---

<aside class="draft-banner" role="status">
  <p class="draft-stamp">Draft</p>
  <div>
    <p class="draft-title">Needs a human pass before it leaves the desk.</p>
    <p class="small">
      Publication facts were checked against the sources listed on this page. Titles, dates, and any
      flagged blurbs still need a person to confirm. This banner stays up on purpose — it is not a
      broken page.
    </p>
  </div>
  {
    flags.length > 0 && (
      <div class="draft-flags">
        <p class="draft-flags-label">Review flags</p>
        <ul class="small" style="margin:0;">
          {flags.map((flag) => (
            <li>{flag}</li>
          ))}
        </ul>
      </div>
    )
  }
</aside>
