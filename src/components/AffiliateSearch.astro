---
import { affiliateTag, amazonSearchUrl } from "../lib/site";

interface Props {
  query: string;
  label?: string;
}

const { query, label = query } = Astro.props;
const href = amazonSearchUrl(query);
---

<div class="disclosure-note">
  <p class="eyebrow">Find the books</p>
  <p>
    Amazon search for <a href={href} rel="sponsored nofollow">{label}</a>. Placeholder tag
    <code>{affiliateTag}</code>.
  </p>
  <p class="small muted">
    As an Amazon Associate I earn from qualifying purchases. Associates is not active yet.
  </p>
</div>
