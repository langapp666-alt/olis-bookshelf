---
import { lookupAsin } from "../lib/asins";
import { amazonAudibleUrl, amazonBookUrl } from "../lib/site";
import { lookupCover, type CoverRecord } from "../lib/covers";
import AmazonLink from "./AmazonLink.astro";
import BookCover from "./BookCover.astro";

export interface OrderBook {
  n?: string | number;
  title: string;
  year?: string | number;
  form?: string;
  notes?: string;
  author?: string;
  query?: string;
  /** Validated amazon.com ASIN only — never invent. Ignored while deep links are off. */
  asin?: string;
  coverId?: number;
  isbn?: string;
  olid?: string;
  gbid?: string;
}

interface Props {
  author: string;
  books: OrderBook[];
  showForm?: boolean;
  showNotes?: boolean;
}

const { author, books, showForm, showNotes } = Astro.props;
const hasForm = showForm ?? books.some((book) => Boolean(book.form));
const hasNotes = showNotes ?? books.some((book) => Boolean(book.notes));
const hasN = books.some((book) => book.n !== undefined && book.n !== "");
const hasYear = books.some((book) => book.year !== undefined && book.year !== "");

type BadgeKind = "start" | "optional" | "stop" | "form";

function badgeFor(book: OrderBook): { label: string; kind: BadgeKind } | null {
  const notes = (book.notes ?? "").toLowerCase();
  const form = (book.form ?? "").toLowerCase();
  if (/do not start|not (an? )?(on-ramp|book one|required)/.test(notes)) {
    return { label: "Do not start here", kind: "stop" };
  }
  if (/start here/.test(notes)) return { label: "Start here", kind: "start" };
  if (/optional/.test(notes) || /optional/.test(form)) return { label: "Optional", kind: "optional" };
  if (/contested/.test(notes)) return { label: "Contested", kind: "optional" };
  if (book.form && !hasForm) return { label: book.form, kind: "form" };
  return null;
}
---

<div class="table-wrap is-stacked">
  <table class="order-table is-stacked">
    <thead>
      <tr>
        {hasN && <th class="col-n" scope="col">#</th>}
        <th class="col-title" scope="col">Title</th>
        {hasForm && <th class="col-form" scope="col">Form</th>}
        {hasYear && <th class="col-year" scope="col">Year</th>}
        {hasNotes && <th class="col-notes" scope="col">Notes</th>}
        <th class="col-amazon" scope="col">Shop</th>
      </tr>
    </thead>
    <tbody>
      {
        books.map((book) => {
          const badge = badgeFor(book);
          const bookAuthor = book.author ?? author;
          const asin = lookupAsin(book.title, bookAuthor, book.asin);
          const shopHref = amazonBookUrl(book.title, bookAuthor, {
            query: book.query,
            asin,
          });
          const audioHref = amazonAudibleUrl(book.title, bookAuthor, book.query);
          return (
            <tr>
              {hasN && (
                <td class="col-n" data-label="#">
                  {book.n ?? ""}
                </td>
              )}
              <td class="col-title" data-label="Title">
                <span class="book-title-cell">
                  <BookCover
                    title={book.title}
                    cover={lookupCover(book.title, bookAuthor, book as CoverRecord)}
                  />
                  <span class="book-title-stack">
                    <span class="book-title">{book.title}</span>
                    {badge && <span class:list={["row-badge", `is-${badge.kind}`]}>{badge.label}</span>}
                  </span>
                </span>
              </td>
              {hasForm && (
                <td class="col-form" data-label="Form">
                  {book.form}
                </td>
              )}
              {hasYear && (
                <td class="col-year" data-label="Year">
                  {book.year}
                </td>
              )}
              {hasNotes && (
                <td class="col-notes" data-label="Notes">
                  {book.notes}
                </td>
              )}
              <td class="col-amazon amazon-cell" data-label="Shop">
                <div class="shop-actions">
                  <AmazonLink class="amazon-link" href={shopHref}>
                    Amazon
                    <span class="visually-hidden">{` search for ${book.title}`}</span>
                  </AmazonLink>
                  <AmazonLink class="audiobook-link" href={audioHref}>
                    Audiobook
                    <span class="visually-hidden">{` search for ${book.title}`}</span>
                  </AmazonLink>
                </div>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
