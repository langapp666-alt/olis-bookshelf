---
import { amazonBookUrl, amazonRel } from "../lib/site";

export interface OrderBook {
  n?: string | number;
  title: string;
  year?: string | number;
  form?: string;
  notes?: string;
  author?: string;
  query?: string;
}

interface Props {
  author: string;
  books: OrderBook[];
  showForm?: boolean;
  showNotes?: boolean;
}

const { author, books, showForm, showNotes } = Astro.props;
const hasForm = showForm ?? books.some((book) => Boolean(book.form));
const hasNotes = showNotes ?? books.some((book) => Boolean(book.notes));
const hasN = books.some((book) => book.n !== undefined && book.n !== "");
const hasYear = books.some((book) => book.year !== undefined && book.year !== "");
---

<div class="table-wrap is-stacked">
  <table class="order-table is-stacked">
    <thead>
      <tr>
        {hasN && <th scope="col">#</th>}
        <th scope="col">Title</th>
        {hasForm && <th scope="col">Form</th>}
        {hasYear && <th scope="col">Year</th>}
        {hasNotes && <th scope="col">Notes</th>}
        <th scope="col">Amazon</th>
      </tr>
    </thead>
    <tbody>
      {
        books.map((book) => (
          <tr>
            {hasN && <td data-label="#">{book.n ?? ""}</td>}
            <td data-label="Title">
              <span class="book-title">{book.title}</span>
            </td>
            {hasForm && <td data-label="Form">{book.form}</td>}
            {hasYear && <td data-label="Year">{book.year}</td>}
            {hasNotes && <td data-label="Notes">{book.notes}</td>}
            <td data-label="Amazon" class="amazon-cell">
              <a
                class="amazon-link"
                href={amazonBookUrl(book.title, book.author ?? author, book.query)}
                rel={amazonRel}
              >
                Amazon
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
