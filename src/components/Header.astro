---
import Logo from "./Logo.astro";

const pathname = Astro.url.pathname;

const shelves = [
  { href: "/guides/", label: "Guides" },
  { href: "/genres/epic-fantasy/", label: "Fantasy" },
  { href: "/genres/space-opera/", label: "Space" },
  { href: "/genres/mystery-thriller/", label: "Mystery" },
  { href: "/genres/romance/", label: "Romance" },
];

const house = [{ href: "/about/", label: "About" }];

function isCurrent(href: string) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap">
    <div class="header-bar">
      <a class="wordmark" href="/">
        <Logo class="wordmark-mark" />
        <span class="wordmark-text">
          <span class="wordmark-oli">Oli's</span>
          <span class="wordmark-shelf">Bookshelf</span>
        </span>
      </a>
      <form class="header-find search-field" action="/guides/" method="get" role="search" data-search-field>
        <label class="header-find-label" for="header-q">Find a series</label>
        <input
          id="header-q"
          type="search"
          name="q"
          placeholder="Find a series"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          data-typeahead
        />
      </form>
      <details class="nav-box" data-nav-box>
        <summary class="nav-toggle">
          Menu
          <span class="nav-toggle-icon" aria-hidden="true"><span></span></span>
        </summary>
        <nav class="nav" aria-label="Primary">
          <form class="nav-find search-field" action="/guides/" method="get" role="search" data-search-field>
            <label class="header-find-label" for="nav-q">Find a series</label>
            <input
              id="nav-q"
              type="search"
              name="q"
              placeholder="Find a series"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
              data-typeahead
            />
          </form>
          <div class="nav-group">
            <p class="nav-label">Shelves</p>
            {
              shelves.map((link) => (
                <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                  {link.label}
                </a>
              ))
            }
          </div>
          <div class="nav-group">
            <p class="nav-label">House</p>
            {
              house.map((link) => (
                <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                  {link.label}
                </a>
              ))
            }
            <a href="/guides/" data-random-guide>
              Random
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const box = document.querySelector<HTMLDetailsElement>("[data-nav-box]");
  if (box) {
    const desktop = window.matchMedia("(min-width: 980px)");
    const sync = () => {
      box.open = desktop.matches;
    };
    sync();
    desktop.addEventListener("change", sync);

    box.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (!desktop.matches) box.open = false;
      });
    });
  }
</script>
