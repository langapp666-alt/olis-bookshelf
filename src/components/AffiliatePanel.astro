---
import { affiliateTag, amazonSearchUrl } from "../lib/site";

interface Props {
  series: string;
  author: string;
  genreLabel: string;
  sources: { label: string; url: string }[];
}

const { series, author, genreLabel, sources } = Astro.props;
const searchHref = amazonSearchUrl(series);
---

<div class="panel">
  <p class="eyebrow">This series</p>
  <p class="aside-series">{series}</p>
  <p class="small muted" style="margin:0 0 0.85rem;">
    {author} · {genreLabel}
  </p>
  <a class="btn" href={searchHref} rel="sponsored nofollow">Search Amazon</a>
  <p class="small muted" style="margin:0.7rem 0 0;">
    Associates tag <code>{affiliateTag}</code>
  </p>
  <hr class="rule" />
  <p class="small" style="margin:0 0 0.55rem;">
    <strong>As an Amazon Associate I earn from qualifying purchases.</strong> Search links may
    earn a commission.
  </p>
  <p class="small" style="margin:0 0 0.85rem;">
    <a href="/disclosure/">Full disclosure</a> · <a href="/methodology/">How the lists are made</a>
  </p>
  <p class="small" style="margin:0 0 0.35rem;"><strong>Sources</strong></p>
  <ul class="source-list small">
    {
      sources.map((source) => (
        <li>
          <a href={source.url}>{source.label}</a>
        </li>
      ))
    }
  </ul>
</div>
