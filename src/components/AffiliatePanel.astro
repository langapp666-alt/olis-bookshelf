---
import { amazonRel, amazonSearchUrl } from "../lib/site";

interface Props {
  series: string;
  author: string;
  genreLabel: string;
  sources: { label: string; url: string }[];
}

const { series, author, genreLabel, sources } = Astro.props;
const searchHref = amazonSearchUrl(`${series} ${author}`);
---

<div class="panel affiliate-panel">
  <p class="eyebrow">This series</p>
  <p class="aside-series">{series}</p>
  <p class="small muted aside-byline">
    {author} · {genreLabel}
  </p>
  <a class="aside-amazon" href={searchHref} rel={amazonRel}>
    Amazon search
    <span class="visually-hidden">{` for ${series}`}</span>
  </a>
  {
    sources.length > 0 && (
      <>
        <hr class="rule" />
        <p class="small aside-sources-label">Sources</p>
        <ul class="source-list small">
          {sources.map((source) => (
            <li>
              <a href={source.url}>{source.label}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</div>
