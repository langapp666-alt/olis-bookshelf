---
import { affiliateTag, amazonRel, amazonSearchUrl } from "../lib/site";

interface Props {
  series: string;
  author: string;
  genreLabel: string;
  sources: { label: string; url: string }[];
}

const { series, author, genreLabel, sources } = Astro.props;
const searchHref = amazonSearchUrl(`${series} ${author}`);
---

<div class="panel affiliate-panel">
  <p class="eyebrow">This series</p>
  <p class="aside-series">{series}</p>
  <p class="small muted aside-byline">
    {author} · {genreLabel}
  </p>
  <a class="btn" href={searchHref} rel={amazonRel}>Search the series on Amazon</a>
  <p class="small muted affiliate-tagline">
    Associates tag <code>{affiliateTag}</code>
  </p>
  <hr class="rule" />
  <p class="small disclosure-copy">
    <strong>As an Amazon Associate I earn from qualifying purchases.</strong>
    Each title in the order tables links to an Amazon search for that book. Series
    search is here if you want the whole shelf.
  </p>
  <p class="small aside-links">
    <a href="/disclosure/">Full disclosure</a>
    ·
    <a href="/methodology/">How the lists are made</a>
  </p>
  {
    sources.length > 0 && (
      <>
        <p class="small aside-sources-label"><strong>Sources</strong></p>
        <ul class="source-list small">
          {sources.map((source) => (
            <li>
              <a href={source.url}>{source.label}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</div>
