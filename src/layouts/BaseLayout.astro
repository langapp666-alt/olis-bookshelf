---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuidesIndex from "../components/GuidesIndex.astro";
import SeoJsonLd from "../components/SeoJsonLd.astro";
import "../styles/global.css";
import { siteName, siteOrigin } from "../lib/site";
import { clipMeta, documentTitle } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  dock?: boolean;
  wide?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, dock = false, wide = false, jsonLd } = Astro.props;
const pageTitle = documentTitle(title);
const metaDescription = clipMeta(description);
const origin = siteOrigin(Astro.site);
const canonical = new URL(Astro.url.pathname, origin);
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: origin.href,
  description:
    "Reading-order maps for long science fiction, fantasy, mystery, and romance series.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: new URL("/guides/?q={search_term_string}", origin).href,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="google-site-verification" content="9jkc3kGkWhu3Yil5wu9SF4CYXjPdrOnniWuBCEV5odQ" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://covers.openlibrary.org" />
    <link rel="dns-prefetch" href="https://covers.openlibrary.org" />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,500&family=Schibsted+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="theme-color" content="#f7f3ea" />
    <SeoJsonLd schema={jsonLd ? [websiteSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : websiteSchema} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <Header />
      <main id="main" class:list={["site-main", { "has-dock": dock }]}>
        <div class:list={["wrap", { "wrap-wide": wide }]}>
          <slot />
        </div>
      </main>
      <Footer />
    </div>
    <GuidesIndex />
    <script>
      import "../scripts/enhance-tables";
      import "../scripts/site-search";
    </script>
  </body>
</html>
