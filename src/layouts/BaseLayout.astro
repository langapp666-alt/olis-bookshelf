---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoJsonLd from "../components/SeoJsonLd.astro";
import "../styles/global.css";
import { socials, siteName, siteOrigin } from "../lib/site";
import { clipMeta, documentTitle } from "../lib/seo";
import { absoluteOgUrl, OG_HEIGHT, OG_WIDTH, siteOgPath } from "../lib/og";

interface Props {
  title: string;
  description: string;
  dock?: boolean;
  wide?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  ogType?: "website" | "article";
  /** LCP cover (or similar) to preload — keep to one URL. */
  preloadImage?: string;
}

const {
  title,
  description,
  dock = false,
  wide = false,
  jsonLd,
  ogImage,
  ogType = "website",
  preloadImage,
} = Astro.props;
const pageTitle = documentTitle(title);
const metaDescription = clipMeta(description);
const origin = siteOrigin(Astro.site);
const canonical = new URL(Astro.url.pathname, origin);
const imagePath = ogImage ?? absoluteOgUrl(origin, siteOgPath());
const imageUrl = imagePath.startsWith("http") ? imagePath : absoluteOgUrl(origin, imagePath);
const twitter = socials.find((item) => item.id === "x");
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: origin.href,
  description:
    "Reading-order maps for long science fiction, fantasy, mystery, and romance series.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: new URL("/guides/?q={search_term_string}", origin).href,
    },
    "query-input": "required name=search_term_string",
  },
};
const fontHref =
  "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="google-site-verification" content="9jkc3kGkWhu3Yil5wu9SF4CYXjPdrOnniWuBCEV5odQ" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://covers.openlibrary.org" />
    <link rel="dns-prefetch" href="https://covers.openlibrary.org" />
    <link rel="dns-prefetch" href="https://books.google.com" />
    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }
    <link rel="preload" as="style" href={fontHref} />
    <link href={fontHref} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href={fontHref} rel="stylesheet" />
    </noscript>
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />
    {twitter && <meta name="twitter:site" content={twitter.handle} />}
    <meta name="theme-color" content="#f3ece0" />
    <SeoJsonLd schema={jsonLd ? [websiteSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : websiteSchema} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <Header />
      <main id="main" class:list={["site-main", { "has-dock": dock }]}>
        <div class:list={["wrap", { "wrap-wide": wide }]}>
          <slot />
        </div>
      </main>
      <Footer />
    </div>
    <script>
      import "../scripts/boot-client";
    </script>
  </body>
</html>
