---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GuideCard from "../components/GuideCard.astro";
import { genres, siteName } from "../lib/site";

const guides = (await getCollection("guides")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title={siteName}
  description="Reading-order maps for long science fiction, fantasy, and mystery series. Publication first, chronology when it matters, and a few next reads with reasons."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Reading orders</p>
      <h1>The next book, not the loudest one.</h1>
      <p class="lede">
        Long series hide the path: prequels that spoil, novellas that look skippable, lists that
        quietly add picture books. We start with publication order, then say where chronology
        actually changes the read.
      </p>
      <div class="btn-row">
        <a class="btn" href="#guides">Open the guides</a>
        <a class="btn btn-secondary" href="/methodology/">How the lists are made</a>
      </div>
    </div>
    <aside class="hero-card">
      <p class="eyebrow">On the shelf</p>
      <p class="hero-stat">Three series, mapped</p>
      <ul class="shelf-list">
        <li>
          <a href="/guides/murderbot-diaries-reading-order/">The Murderbot Diaries</a>
        </li>
        <li>
          <a href="/guides/the-expanse-reading-order/">The Expanse</a>
        </li>
        <li>
          <a href="/guides/discworld-city-watch-reading-order/">Discworld City Watch</a>
        </li>
      </ul>
    </aside>
  </section>

  <hr class="rule-break" />

  <header class="section-head" id="guides">
    <p class="eyebrow">Guides</p>
    <h2>Publication order, then the traps</h2>
  </header>
  <div class="catalog">
    {guides.map((guide, i) => <GuideCard guide={guide} index={i + 1} />)}
  </div>

  <header class="section-head">
    <p class="eyebrow">Browse</p>
    <h2>Shelves</h2>
  </header>
  <div class="grid-3">
    {
      Object.values(genres).map((genre) => (
        <a class="genre-card" href={`/genres/${genre.slug}/`}>
          <p class="eyebrow">{genre.label}</p>
          <p style="margin:0;">{genre.blurb}</p>
          <p class="card-cta">Open this shelf</p>
        </a>
      ))
    }
  </div>

  <div class="house-note colophon">
    <h2>House rules</h2>
    <ul>
      <li>No jacket copy, chapter quotes, or invented reader reactions.</li>
      <li>No star ratings, and no “best book in the series.”</li>
      <li>Amazon Associates is not active. Search links carry a placeholder tag only.</li>
      <li>We skip Harry Potter, Tolkien, A Song of Ice and Fire, and Star Wars. Those paths are already mapped.</li>
    </ul>
  </div>
</BaseLayout>
