---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogFind from "../components/CatalogFind.astro";
import CoverStack from "../components/CoverStack.astro";
import GuideCard from "../components/GuideCard.astro";
import RandomGuide from "../components/RandomGuide.astro";
import {
  featuredSlugs,
  genrePrioritySlugs,
  guidesBySlug,
  prioritizeGuides,
  SHELF_PREVIEW,
  sortGuides,
  spotlightSlugs,
} from "../lib/catalog";
import { listedGuides } from "../lib/guides-index";
import PopularQuestions from "../components/PopularQuestions.astro";
import { popularQuestionSlugs, questionsBySlug, listedQuestions } from "../lib/questions";
import { genres, siteOrigin, type GenreSlug } from "../lib/site";

const allGuides = sortGuides(listedGuides(await getCollection("guides")));
const guideCount = allGuides.length;
const featured = guidesBySlug(allGuides, featuredSlugs);
const spotlight = guidesBySlug(allGuides, spotlightSlugs);
const stack = featured.slice(0, 3);
const popularQuestions = questionsBySlug(
  listedQuestions(await getCollection("questions")),
  popularQuestionSlugs,
);

const shelves = Object.values(genres).map((genre) => ({
  genre,
  guides: prioritizeGuides(
    allGuides.filter((guide) => guide.data.genre === (genre.slug as GenreSlug)),
    genrePrioritySlugs[genre.slug as GenreSlug],
  ),
}));
---

<BaseLayout
  title="Reading-order guides: where to start"
  description="Where to start Murderbot, Mistborn, Kingkiller, Shatter Me, Lunar Chronicles, James Bond, Roots of Chaos, and 100+ long series. Publication first."
  wide
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Reading-order guides: where to start",
    url: new URL("/", siteOrigin(Astro.site)).href,
    description:
      "Where to start long science fiction, fantasy, mystery, and romance series. Publication first.",
  }}
>
  <section class="masthead" data-masthead>
    <div class="masthead-copy">
      <p class="eyebrow">Reading-order maps</p>
      <h1>Know the next book — not the loudest one.</h1>
      <p class="lede">
        {guideCount} spoiler-light paths for long science fiction, fantasy, mystery, and romance
        series. Publication first. Chronology when it actually changes the read. Optional extras
        stay labeled.
      </p>
      <div class="btn-row">
        <a class="btn" href="/guides/">Browse guides</a>
        <a class="btn btn-ghost" href="/questions/">Popular questions</a>
        <RandomGuide />
        <a class="btn btn-ghost" href="#find">Find a series</a>
      </div>
      <p class="hero-note">
        <a href="/methodology/">How the lists are made</a>
        {" · "}
        <a href="/questions/">All question hubs</a>
      </p>
    </div>
    <CoverStack guides={stack} />
  </section>

  <CatalogFind id="find" total={guideCount} filterable={false} chipLinks action="/guides/" />

  <section class="worlds-block" data-featured>
    <header class="shelf-head">
      <div>
        <p class="eyebrow">Start here</p>
        <h2>Choose a world</h2>
        <p class="shelf-blurb">
          High-traffic series people still start on the wrong book. Genre, a short path, and the
          first honest title.
        </p>
      </div>
      <p class="shelf-count">{featured.length} featured</p>
    </header>
    <div class="world-grid">
      {
        featured.map((guide, i) => (
          <GuideCard guide={guide} variant="featured" priority={i < 2} filterable={false} />
        ))
      }
    </div>
  </section>

  <PopularQuestions questions={popularQuestions} />

  <section class="worlds-block">
    <header class="shelf-head">
      <div>
        <p class="eyebrow">Deep catalog</p>
        <h2>Long maps, still labeled</h2>
        <p class="shelf-blurb">
          Multi-door universes and long runs where a spreadsheet is the usual wrong answer.
        </p>
      </div>
      <p class="shelf-count">
        <a href="/guides/">All {guideCount} maps</a>
      </p>
    </header>
    <div class="world-grid">
      {
        spotlight.map((guide) => (
          <GuideCard guide={guide} variant="catalog" filterable={false} />
        ))
      }
    </div>
  </section>

  {
    shelves.map(({ genre, guides }) =>
      guides.length > 0 ? (
        <section class="shelf-block">
          <header class="shelf-head">
            <div>
              <p class="eyebrow">Shelf</p>
              <h2>
                <a href={`/genres/${genre.slug}/`}>{genre.label}</a>
              </h2>
              <p class="shelf-blurb">{genre.blurb}</p>
            </div>
            <p class="shelf-count">
              <a href={`/genres/${genre.slug}/`}>
                {guides.length === 1 ? "1 map" : `${guides.length} maps`}
              </a>
            </p>
          </header>
          <div class="world-grid is-compact">
            {guides.slice(0, SHELF_PREVIEW).map((guide) => (
              <GuideCard guide={guide} variant="catalog" filterable={false} />
            ))}
          </div>
          {
            guides.length > SHELF_PREVIEW && (
              <p class="shelf-more">
                <a href={`/genres/${genre.slug}/`}>
                  All {guides.length} {genre.label} maps
                </a>
              </p>
            )
          }
        </section>
      ) : null,
    )
  }

  <div class="house-note colophon">
    <h2>House rules</h2>
    <ul>
      <li>No jacket copy, chapter quotes, or invented reader reactions.</li>
      <li>No star ratings, and no “best book in the series.”</li>
      <li>
        Publication first. Contested prequel orders stay labeled.{" "}
        <a href="/guides/murderbot-diaries-reading-order/">Murderbot</a> starts
        at <em>All Systems Red</em>.{" "}
        <a href="/guides/mistborn-era-1-2-reading-order/">Mistborn</a> is Era 1
        before <em>Alloy</em>.{" "}
        <a href="/guides/kingkiller-chronicle-reading-order/">Kingkiller</a>{" "}
        starts at <em>The Name of the Wind</em>.{" "}
        <a href="/guides/shatter-me-reading-order/">Shatter Me</a>,{" "}
        <a href="/guides/lunar-chronicles-reading-order/">Lunar Chronicles</a>,
        and <a href="/guides/james-bond-reading-order/">James Bond</a> keep
        films and later cycles off book one.{" "}
        <a href="/guides/roots-of-chaos-reading-order/">Roots of Chaos</a> starts
        at <em>Priory</em>.{" "}
        <a href="/guides/hierarchy-reading-order/">The Will of the Many books in order</a>{" "}
        is James Islington’s Hierarchy.{" "}
        <a href="/guides/malazan-book-of-the-fallen-reading-order/">Book of the Fallen reading order</a>{" "}
        starts at <em>Gardens of the Moon</em>.{" "}
        <a href="/questions/where-to-start-malazan/">Where to start Malazan Book of the Fallen</a>{" "}
        is the short door.{" "}
        <a href="/guides/osten-ard-reading-order/">Osten Ard</a> starts at{" "}
        <em>The Dragonbone Chair</em>.{" "}
        <a href="/guides/harry-bosch-reading-order/">Bosch</a> starts at{" "}
        <em>The Black Echo</em>.{" "}
        <a href="/guides/warrior-cats-reading-order/">Warrior Cats</a> starts at{" "}
        <em>Into the Wild</em>.{" "}
        <a href="/guides/in-death-reading-order/">In Death</a> starts at{" "}
        <em>Naked in Death</em>.{" "}
        <a href="/genres/epic-fantasy/">Epic Fantasy</a>,{" "}
        <a href="/genres/space-opera/">Space Opera</a>,{" "}
        <a href="/genres/mystery-thriller/">Mystery</a>, and{" "}
        <a href="/genres/romance/">Romance</a> hubs group the rest.{" "}
        <a href="/guides/empyrean-reading-order/">Empyrean</a> starts at{" "}
        <em>Fourth Wing</em> (2023).{" "}
        <a href="/guides/throne-of-glass-reading-order/">Throne of Glass</a>{" "}
        (2012),{" "}
        <a href="/guides/grishaverse-reading-order/">Grishaverse</a> (
        <em>Shadow and Bone</em>, 2012), and{" "}
        <a href="/guides/folk-of-the-air-reading-order/">Folk of the Air</a> (
        <em>The Cruel Prince</em>, 2018) are the other romantasy doors.{" "}
        <a href="/guides/zodiac-academy-reading-order/">Zodiac Academy</a> starts
        at <em>The Awakening</em> (2019). After ACOTAR, use{" "}
        <a href="/questions/what-to-read-after-acotar/">what to read after ACOTAR</a>.
        Star Wars stays out as a primary.
      </li>
    </ul>
    <p class="small muted">
      The method is on the <a href="/methodology/">methodology</a> page.
    </p>
  </div>
</BaseLayout>
