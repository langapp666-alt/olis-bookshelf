---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogFind from "../../components/CatalogFind.astro";
import CommonQuestions from "../../components/CommonQuestions.astro";
import GuideCard from "../../components/GuideCard.astro";
import { genrePrioritySlugs, prioritizeGuides, sortGuides } from "../../lib/catalog";
import { listedGuides } from "../../lib/guides-index";
import { listedQuestions } from "../../lib/questions";
import { genres, siteOrigin, type GenreSlug } from "../../lib/site";

export function getStaticPaths() {
  return Object.values(genres).map((genre) => ({
    params: { slug: genre.slug },
    props: { genre },
  }));
}

const { genre } = Astro.props;
const guides = prioritizeGuides(
  sortGuides(
    listedGuides(await getCollection("guides")).filter(
      (entry) => entry.data.genre === (genre.slug as GenreSlug),
    ),
  ),
  genrePrioritySlugs[genre.slug as GenreSlug],
);
const priority = guides.filter((guide) =>
  (genrePrioritySlugs[genre.slug as GenreSlug] as readonly string[]).includes(guide.data.slug),
);
const asked = listedQuestions(await getCollection("questions"))
  .filter((question) => question.data.genre === (genre.slug as GenreSlug))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const askedPreview = asked.slice(0, 8);
---

<BaseLayout
  title={`${genre.label} reading order`}
  description={genre.blurb}
  wide
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${genre.label} reading order`,
    url: new URL(`/genres/${genre.slug}/`, siteOrigin(Astro.site)).href,
    description: genre.blurb,
  }}
>
  <header class="page-head catalog-page-head">
    <p class="eyebrow">Shelf</p>
    <h1>{genre.label} reading-order guides</h1>
    <p class="lede">{genre.blurb}</p>
    <p class="shelf-jump">
      <a href="/guides/">All maps</a>
      <a href="/questions/">Questions</a>
      {
        Object.values(genres)
          .filter((other) => other.slug !== genre.slug)
          .map((other) => (
            <a href={`/genres/${other.slug}/`}>{other.label}</a>
          ))
      }
    </p>
  </header>

  <CatalogFind id="find" total={guides.length} chips={false} placeholder="Series or author on this shelf" />

  <p class="catalog-empty" data-catalog-empty hidden>No series on this shelf matches that search.</p>

  {
    priority.length > 0 && (
      <section class="worlds-block" data-featured>
        <header class="shelf-head">
          <div>
            <p class="eyebrow">Doors people get wrong</p>
            <h2>Start with these maps</h2>
            <p class="shelf-blurb">
              Contested on-ramps on this shelf. Open the map before a chronology chart or a film
              list.
            </p>
          </div>
          <p class="shelf-count">{priority.length} doors</p>
        </header>
        <div class="world-grid">
          {priority.map((guide, i) => (
            <GuideCard guide={guide} variant="featured" priority={i < 2} filterable={false} />
          ))}
        </div>
      </section>
    )
  }

  <CommonQuestions questions={askedPreview} />
  {
    asked.length > askedPreview.length && (
      <p class="shelf-more">
        <a href="/questions/">All {asked.length} {genre.label} questions</a>
      </p>
    )
  }

  <header class="shelf-head">
    <div>
      <p class="eyebrow">On this shelf</p>
      <h2>{guides.length === 1 ? "1 map" : `${guides.length} maps`}</h2>
    </div>
  </header>
  {
    guides.length > 0 ? (
      <div class="world-grid">
        {guides.map((guide) => (
          <GuideCard guide={guide} variant="catalog" />
        ))}
      </div>
    ) : (
      <p>No guide in this hub yet.</p>
    )
  }
</BaseLayout>
