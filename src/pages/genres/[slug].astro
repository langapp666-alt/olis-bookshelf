---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideCard from "../../components/GuideCard.astro";
import { genres, type GenreSlug } from "../../lib/site";

export function getStaticPaths() {
  return Object.values(genres).map((genre) => ({
    params: { slug: genre.slug },
    props: { genre },
  }));
}

const { genre } = Astro.props;
const guides = (await getCollection("guides")).filter(
  (entry) => entry.data.genre === (genre.slug as GenreSlug),
);

const queued: Record<GenreSlug, string[]> = {
  "epic-fantasy": [
    "The Locked Tomb — Tamsyn Muir",
    "Mistborn Era 1 + 2 — Brandon Sanderson",
    "The Books of Babel — Josiah Bancroft",
    "The Craft Sequence — Max Gladstone",
  ],
  "space-opera": [
    "Foreigner — C. J. Cherryh",
    "The Culture — Iain M. Banks",
  ],
  "mystery-thriller": [
    "Rivers of London — Ben Aaronovitch",
    "The Dresden Files — Jim Butcher",
    "October Daye — Seanan McGuire",
    "InCryptid — Seanan McGuire",
    "Jackson Brodie — Kate Atkinson",
    "Cormoran Strike — Robert Galbraith",
  ],
};
---

<BaseLayout title={genre.label} description={genre.blurb}>
  <header class="page-head">
    <p class="eyebrow">Shelf</p>
    <h1>{genre.label}</h1>
    <p class="lede">{genre.blurb}</p>
  </header>

  <header class="section-head">
    <p class="eyebrow">On this shelf</p>
    <h2>Guides</h2>
  </header>
  {
    guides.length > 0 ? (
      <div class="card-grid">
        {guides.map((guide) => (
          <GuideCard guide={guide} />
        ))}
      </div>
    ) : (
      <p>Nothing mapped here yet. The series below are next.</p>
    )
  }

  <div class="house-note colophon">
    <h2>Coming next</h2>
    <p class="small muted">Titles we intend to map. Not guides yet.</p>
    <ul>
      {queued[genre.slug as GenreSlug].map((item) => <li>{item}</li>)}
    </ul>
  </div>
</BaseLayout>
