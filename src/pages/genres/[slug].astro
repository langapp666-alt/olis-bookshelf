---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideCard from "../../components/GuideCard.astro";
import { genres, type GenreSlug } from "../../lib/site";

export function getStaticPaths() {
  return Object.values(genres).map((genre) => ({
    params: { slug: genre.slug },
    props: { genre },
  }));
}

const { genre } = Astro.props;
const guides = (await getCollection("guides"))
  .filter((entry) => entry.data.genre === (genre.slug as GenreSlug))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const queued: Record<GenreSlug, string[]> = {
  "epic-fantasy": [],
  "space-opera": ["Foreigner — C. J. Cherryh"],
  "mystery-thriller": [
    "October Daye — Seanan McGuire",
    "InCryptid — Seanan McGuire",
    "Jackson Brodie — Kate Atkinson",
  ],
};
---

<BaseLayout title={genre.label} description={genre.blurb}>
  <header class="page-head">
    <p class="eyebrow">Shelf</p>
    <h1>{genre.label}</h1>
    <p class="lede">{genre.blurb}</p>
  </header>

  <header class="section-head">
    <p class="eyebrow">On this shelf</p>
    <h2>Guides</h2>
  </header>
  {
    guides.length > 0 ? (
      <div class="card-grid">
        {guides.map((guide) => (
          <GuideCard guide={guide} />
        ))}
      </div>
    ) : (
      <p>No guide in this hub yet. The backlog below is the queue.</p>
    )
  }

  {
    queued[genre.slug as GenreSlug].length > 0 && (
      <div class="house-note colophon">
        <h2>Still queued</h2>
        <p class="small muted">
          From <code>docs/SERIES_BACKLOG.md</code>. Not yet a guide.
        </p>
        <ul>
          {queued[genre.slug as GenreSlug].map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
</BaseLayout>
