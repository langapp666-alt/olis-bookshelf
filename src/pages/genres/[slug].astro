---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideCard from "../../components/GuideCard.astro";
import { genres, type GenreSlug } from "../../lib/site";

export function getStaticPaths() {
  return Object.values(genres).map((genre) => ({
    params: { slug: genre.slug },
    props: { genre },
  }));
}

const { genre } = Astro.props;
const guides = (await getCollection("guides"))
  .filter((entry) => entry.data.genre === (genre.slug as GenreSlug))
  .sort((a, b) => a.data.series.localeCompare(b.data.series));
---

<BaseLayout title={genre.label} description={genre.blurb}>
  <header class="page-head">
    <p class="eyebrow">Shelf</p>
    <h1>{genre.label}</h1>
    <p class="lede">{genre.blurb}</p>
  </header>

  <header class="section-head">
    <p class="eyebrow">On this shelf</p>
    <h2>{guides.length === 1 ? "1 guide" : `${guides.length} guides`}</h2>
  </header>
  {
    guides.length > 0 ? (
      <div class="catalog catalog-compact">
        {guides.map((guide) => (
          <GuideCard guide={guide} compact />
        ))}
      </div>
    ) : (
      <p>No guide in this hub yet.</p>
    )
  }
</BaseLayout>
