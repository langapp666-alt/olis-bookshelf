---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogFind from "../../components/CatalogFind.astro";
import GuideCard from "../../components/GuideCard.astro";
import PopularQuestions from "../../components/PopularQuestions.astro";
import {
  featuredSlugs,
  genrePrioritySlugs,
  guidesBySlug,
  prioritizeGuides,
  sortGuides,
} from "../../lib/catalog";
import { listedGuides } from "../../lib/guides-index";
import { listedQuestions, popularQuestionSlugs, questionsBySlug } from "../../lib/questions";
import { genres, siteOrigin, type GenreSlug } from "../../lib/site";

const allGuides = sortGuides(listedGuides(await getCollection("guides")));
const featured = guidesBySlug(allGuides, featuredSlugs);
const popularQuestions = questionsBySlug(
  listedQuestions(await getCollection("questions")),
  popularQuestionSlugs,
);

const shelves = Object.values(genres).map((genre) => ({
  genre,
  guides: prioritizeGuides(
    allGuides.filter((guide) => guide.data.genre === (genre.slug as GenreSlug)),
    genrePrioritySlugs[genre.slug as GenreSlug],
  ),
}));
---

<BaseLayout
  title="All reading-order guides"
  description="Every Oli's Bookshelf map: Murderbot, Mistborn, Kingkiller, Shatter Me, Lunar Chronicles, James Bond, plus Witcher, Cosmere, and romantasy. Publication first."
  wide
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "All reading-order guides",
    url: new URL("/guides/", siteOrigin(Astro.site)).href,
    description: "All series reading-order guides, grouped by shelf.",
  }}
>
  <header class="page-head catalog-page-head">
    <p class="eyebrow">Catalog</p>
    <h1>Reading-order guides</h1>
    <p class="lede">
      {allGuides.length} series maps, grouped by{" "}
      <a href="/genres/epic-fantasy/">Epic Fantasy</a>,{" "}
      <a href="/genres/space-opera/">Space Opera</a>,{" "}
      <a href="/genres/mystery-thriller/">Mystery</a>, and{" "}
      <a href="/genres/romance/">Romance</a>. Publication order first. Chronology
      when it actually changes the read — including{" "}
      <a href="/guides/murderbot-diaries-reading-order/">Murderbot</a>,{" "}
      <a href="/guides/kingkiller-chronicle-reading-order/">Kingkiller</a>,{" "}
      <a href="/guides/shatter-me-reading-order/">Shatter Me</a>,{" "}
      <a href="/guides/lunar-chronicles-reading-order/">Lunar Chronicles</a>,{" "}
      <a href="/guides/james-bond-reading-order/">James Bond</a>,{" "}
      <a href="/guides/osten-ard-reading-order/">Osten Ard</a>,{" "}
      <a href="/guides/riftwar-reading-order/">Riftwar</a>, and{" "}
      <a href="/guides/harry-bosch-reading-order/">Harry Bosch</a>.
      Under-linked doors on those shelves:{" "}
      <a href="/guides/amber-chronicles-reading-order/">Amber</a> (<em>Nine Princes in Amber</em>, 1970),{" "}
      <a href="/guides/valdemar-reading-order/">Valdemar</a> (<em>Arrows of the Queen</em>, 1987),{" "}
      <a href="/guides/old-kingdom-reading-order/">Old Kingdom</a> (<em>Sabriel</em>, 1995), and{" "}
      <a href="/guides/honorverse-reading-order/">Honor Harrington</a> (<em>On Basilisk Station</em>, 1993).
    </p>
  </header>

  <CatalogFind id="find" total={allGuides.length} placeholder="Series or author" />

  <p class="catalog-empty" data-catalog-empty hidden>No series on this shelf matches that search.</p>

  <section class="worlds-block" data-featured>
    <header class="shelf-head">
      <div>
        <p class="eyebrow">Popular</p>
        <h2>Start here — paths people usually get wrong</h2>
      </div>
      <p class="shelf-count">{featured.length} featured</p>
    </header>
    <div class="world-grid">
      {
        featured.map((guide, i) => (
          <GuideCard guide={guide} variant="featured" priority={i < 2} filterable={false} />
        ))
      }
    </div>
  </section>

  <PopularQuestions
    questions={popularQuestions}
    heading="Popular reading-order questions"
    blurb="Short where-to-start answers that point at the full map on this catalog."
  />

  {
    shelves.map(({ genre, guides }) =>
      guides.length > 0 ? (
        <section class="shelf-block" data-shelf>
          <header class="shelf-head">
            <div>
              <p class="eyebrow">Shelf</p>
              <h2>
                <a href={`/genres/${genre.slug}/`}>{genre.label}</a>
              </h2>
            </div>
            <p class="shelf-count" data-shelf-total={guides.length}>
              <a href={`/genres/${genre.slug}/`}>
                {guides.length === 1 ? "1 map" : `${guides.length} maps`}
              </a>
            </p>
          </header>
          <div class="world-grid is-compact">
            {guides.map((guide) => (
              <GuideCard guide={guide} variant="catalog" />
            ))}
          </div>
        </section>
      ) : null,
    )
  }
</BaseLayout>
