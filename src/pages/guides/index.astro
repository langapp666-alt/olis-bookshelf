---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogFind from "../../components/CatalogFind.astro";
import GuideCard from "../../components/GuideCard.astro";
import { featuredSlugs, guidesBySlug, sortGuides } from "../../lib/catalog";
import { listedGuides } from "../../lib/guides-index";
import { genres, siteOrigin, type GenreSlug } from "../../lib/site";

const allGuides = sortGuides(listedGuides(await getCollection("guides")));
const featured = guidesBySlug(allGuides, featuredSlugs);

const shelves = Object.values(genres).map((genre) => ({
  genre,
  guides: allGuides.filter((guide) => guide.data.genre === (genre.slug as GenreSlug)),
}));
---

<BaseLayout
  title="Reading-order guides"
  description="All Oli's Bookshelf series reading-order guides, grouped by shelf. Publication first, chronology when it matters."
  wide
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Reading-order guides",
    url: new URL("/guides/", siteOrigin(Astro.site)).href,
    description: "All series reading-order guides, grouped by shelf.",
  }}
>
  <header class="page-head catalog-page-head">
    <p class="eyebrow">Catalog</p>
    <h1>Reading-order guides</h1>
    <p class="lede">
      {allGuides.length} series maps, grouped by shelf. Publication order first.
      Chronology when it actually changes the read.
    </p>
  </header>

  <CatalogFind id="find" total={allGuides.length} placeholder="Series or author" />

  <p class="catalog-empty" data-catalog-empty hidden>No series on this shelf matches that search.</p>

  <section class="worlds-block" data-featured>
    <header class="shelf-head">
      <div>
        <p class="eyebrow">Popular</p>
        <h2>Start here — paths people usually get wrong</h2>
      </div>
      <p class="shelf-count">{featured.length} featured</p>
    </header>
    <div class="world-grid">
      {
        featured.map((guide, i) => (
          <GuideCard guide={guide} variant="featured" priority={i < 2} filterable={false} />
        ))
      }
    </div>
  </section>

  {
    shelves.map(({ genre, guides }) =>
      guides.length > 0 ? (
        <section class="shelf-block" data-shelf>
          <header class="shelf-head">
            <div>
              <p class="eyebrow">Shelf</p>
              <h2>
                <a href={`/genres/${genre.slug}/`}>{genre.label}</a>
              </h2>
            </div>
            <p class="shelf-count" data-shelf-total={guides.length}>
              <a href={`/genres/${genre.slug}/`}>
                {guides.length === 1 ? "1 map" : `${guides.length} maps`}
              </a>
            </p>
          </header>
          <div class="world-grid is-compact">
            {guides.map((guide) => (
              <GuideCard guide={guide} variant="catalog" />
            ))}
          </div>
        </section>
      ) : null,
    )
  }
</BaseLayout>
