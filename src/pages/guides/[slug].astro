---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AffiliatePanel from "../../components/AffiliatePanel.astro";
import AffiliateDock from "../../components/AffiliateDock.astro";
import GuideToc from "../../components/GuideToc.astro";
import OrderTable from "../../components/OrderTable.astro";
import StartHere from "../../components/StartHere.astro";
import { formatDate, genres } from "../../lib/site";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const genre = genres[guide.data.genre];
---

<BaseLayout title={guide.data.title} description={guide.data.description} dock>
  <article class="guide-page">
    <header class="page-head guide-head">
      <p class="eyebrow">
        <a href={`/genres/${genre.slug}/`}>{genre.label}</a>
      </p>
      <h1>{guide.data.title}</h1>
      <p class="lede">{guide.data.description}</p>
      <div class="pill-row">
        <span class="pill">{guide.data.author}</span>
        <span class="pill">Checked {formatDate(guide.data.lastVerified)}</span>
      </div>
    </header>

    <div class="guide-layout">
      <div class="prose guide-prose">
        <Content components={{ OrderTable, StartHere }} />
      </div>
      <aside class="guide-aside">
        <GuideToc headings={headings} />
        <AffiliatePanel
          series={guide.data.series}
          author={guide.data.author}
          genreLabel={genre.label}
          sources={guide.data.sources}
        />
      </aside>
    </div>
  </article>
  <AffiliateDock query={`${guide.data.series} ${guide.data.author}`} label={guide.data.series} />
</BaseLayout>
