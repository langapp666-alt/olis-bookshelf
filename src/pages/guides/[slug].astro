---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AffiliateDock from "../../components/AffiliateDock.astro";
import GuideAside from "../../components/GuideAside.astro";
import GuideHero from "../../components/GuideHero.astro";
import OrderTable from "../../components/OrderTable.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import StartHere from "../../components/StartHere.astro";
import { relatedGuides } from "../../lib/related-guides";
import { listedGuides } from "../../lib/guides-index";
import { genres, isoDate, siteName, siteOrigin } from "../../lib/site";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { guide, guides },
  }));
}

const { guide, guides } = Astro.props;
const { Content, headings } = await render(guide);
const genre = genres[guide.data.genre];
const related = relatedGuides(guide, listedGuides(guides));
const origin = siteOrigin(Astro.site);
const canonical = new URL(`/guides/${guide.data.slug}/`, origin);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: siteName, item: new URL("/", origin).href },
    { "@type": "ListItem", position: 2, name: "Guides", item: new URL("/guides/", origin).href },
    {
      "@type": "ListItem",
      position: 3,
      name: genre.label,
      item: new URL(`/genres/${genre.slug}/`, origin).href,
    },
    { "@type": "ListItem", position: 4, name: guide.data.title, item: canonical.href },
  ],
};
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  dateModified: isoDate(guide.data.lastVerified),
  author: { "@type": "Organization", name: siteName },
  publisher: { "@type": "Organization", name: siteName },
  mainEntityOfPage: canonical.href,
};
---

<BaseLayout title={guide.data.title} description={guide.data.description} dock jsonLd={[breadcrumbSchema, articleSchema]}>
  <article class="guide-page">
    <GuideHero guide={guide} headings={headings} />

    <div class="guide-layout">
      <div class="prose guide-prose">
        <Content components={{ OrderTable, StartHere }} />
      </div>
      <GuideAside guide={guide} headings={headings} related={related} />
    </div>
    <RelatedGuides guides={related} />
  </article>
  <AffiliateDock query={`${guide.data.series} ${guide.data.author}`} label={guide.data.series} />
</BaseLayout>
