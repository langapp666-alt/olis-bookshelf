---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listedQuestions, questionHref } from "../../lib/questions";
import { genres, siteName, siteOrigin, type GenreSlug } from "../../lib/site";
import { absoluteOgUrl, siteOgPath } from "../../lib/og";
import { breadcrumbSchema, webPageSchema } from "../../lib/guide-schema";

const questions = listedQuestions(await getCollection("questions")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const origin = siteOrigin(Astro.site);
const canonical = new URL("/questions/", origin);
const ogImage = absoluteOgUrl(origin, siteOgPath());

const shelves = Object.values(genres)
  .map((genre) => ({
    genre,
    questions: questions.filter((question) => question.data.genre === (genre.slug as GenreSlug)),
  }))
  .filter((shelf) => shelf.questions.length > 0);
---

<BaseLayout
  title="Where to start — common questions"
  description="Short answers to reading-order questions: where to start, publication vs chronological, which book is actually first. Then the full guide."
  jsonLd={[
    webPageSchema({
      name: "Where to start — common questions",
      description: "Short answers to reading-order questions, then a link to the full guide.",
      url: canonical.href,
      origin: origin.href,
      siteName,
      image: ogImage,
    }),
    breadcrumbSchema([
      { name: siteName, item: new URL("/", origin).href },
      { name: "Questions", item: canonical.href },
    ]),
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Where to start — common questions",
      url: canonical.href,
    },
  ]}
  ogImage={ogImage}
>
  <header class="page-head catalog-page-head">
    <p class="eyebrow">Questions</p>
    <h1>Where to start — answered briefly</h1>
    <p class="lede">
      {questions.length} short pages for searches that want a door, not a 40-title chart. Each one
      points at the full map on <a href="/guides/">All guides</a>. Contested shelves live under{" "}
      <a href="/genres/epic-fantasy/">Epic Fantasy</a>,{" "}
      <a href="/genres/space-opera/">Space Opera</a>,{" "}
      <a href="/genres/mystery-thriller/">Mystery</a>, and{" "}
      <a href="/genres/romance/">Romance</a> — including{" "}
      <a href="/guides/empyrean-reading-order/">Fourth Wing</a>,{" "}
      <a href="/guides/mistborn-era-1-2-reading-order/">Mistborn</a>,{" "}
      <a href="/guides/murderbot-diaries-reading-order/">Murderbot</a>,{" "}
      <a href="/guides/bargainer-reading-order/">Bargainer</a>,{" "}
      <a href="/questions/where-to-start-osten-ard/">Osten Ard</a>, and{" "}
      <a href="/questions/where-to-start-harry-bosch/">Harry Bosch</a>.
      Also{" "}
      <a href="/questions/where-to-start-laundry-files/">where to start the Laundry Files</a>,{" "}
      <a href="/questions/drizzt-homeland-or-crystal-shard/">Drizzt’s two doors</a>, and{" "}
      <a href="/questions/foreigner-start-later-arc/">Foreigner arc starts</a>.
      Also{" "}
      <a href="/questions/what-to-read-after-acotar/">what to read after ACOTAR</a>,{" "}
      <a href="/questions/hades-persephone-touch-or-game/">Touch or Game</a> (<em>A Touch of Darkness</em>, 2019),{" "}
      <a href="/questions/artemis-fowl-series-order/">Artemis Fowl</a> (2001), and{" "}
      <a href="/questions/where-to-start-discworld/">where to start Discworld</a> (<em>Guards! Guards!</em>, 1989),{" "}
      <a href="/questions/where-to-start-malazan/">where to start Malazan Book of the Fallen</a>, and{" "}
      <a href="/guides/hierarchy-reading-order/">The Will of the Many books in order</a>.
    </p>
  </header>

  {
    shelves.map(({ genre, questions: items }) => (
      <section class="shelf-block">
        <header class="shelf-head">
          <div>
            <p class="eyebrow">Shelf</p>
            <h2>
              <a href={`/genres/${genre.slug}/`}>{genre.label}</a>
            </h2>
          </div>
          <p class="shelf-count">
            {items.length === 1 ? "1 question" : `${items.length} questions`}
          </p>
        </header>
        <ul class="question-index">
          {items.map((question) => (
            <li>
              <a class="question-index-card" href={questionHref(question.data.slug)}>
                <span class="question-index-kicker">{question.data.shortAnswerTitle}</span>
                <span class="question-index-title">{question.data.title}</span>
                <span class="question-index-desc">{question.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
