---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="That page is not on Oli's Bookshelf."
>
  <header class="page-head">
    <p class="eyebrow">404</p>
    <h1>This shelf is empty</h1>
    <p class="lede">The page you asked for is not in the collection.</p>
  </header>
  <div class="btn-row">
    <a class="btn" href="/">Back to the desk</a>
    <a class="btn btn-secondary" href="/methodology/">How we build lists</a>
  </div>
</BaseLayout>
