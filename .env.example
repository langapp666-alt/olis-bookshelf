# Public Amazon Associates tracking tag (not a secret).
# src/lib/site.ts reads PUBLIC_AFFILIATE_TAG and falls back to olisbookshelf-20.
PUBLIC_AFFILIATE_TAG=olisbookshelf-20

# Canonical site origin (no trailing slash). astro.config.mjs reads this first,
# then SITE_URL, then https://olis-bookshelf.pages.dev.
# Swap to a custom domain later without rewriting pages.
PUBLIC_SITE_URL=https://olis-bookshelf.pages.dev
