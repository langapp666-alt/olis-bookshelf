# Public Amazon Associates tracking tag (not a secret).
# src/lib/site.ts reads PUBLIC_AFFILIATE_TAG and falls back to olisbookshelf-20.
PUBLIC_AFFILIATE_TAG=olisbookshelf-20

# Canonical site origin (no trailing slash). astro.config.mjs and src/lib/site.ts
# read PUBLIC_SITE_URL, then SITE_URL, then https://olisbookshelf.com.
# A leftover https://olis-bookshelf.pages.dev value is ignored so canonicals
# stay on the custom domain. pages.dev remains an alternate host via relative links.
PUBLIC_SITE_URL=https://olisbookshelf.com
